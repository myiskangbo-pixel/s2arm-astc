--- s2arm-pristine/S2Arm-main/graphics/nvn/gfx/tex/nvn_fmt_mtl.c	2026-11-23 09:54:04.000000000 +0000
+++ s2arm-patch-base/S2Arm-main/graphics/nvn/gfx/tex/nvn_fmt_mtl.c	2026-11-23 10:36:07.667362643 +0000
@@ -110,3 +110,12 @@
     else if (swz) { swz[0] = e.rb ? NVN_SWZ_B : NVN_SWZ_R; swz[1] = NVN_SWZ_G; swz[2] = e.rb ? NVN_SWZ_R : NVN_SWZ_B; swz[3] = e.noalpha ? NVN_SWZ_ONE : NVN_SWZ_A; }
     return e.kind;
 }
+
+// Keep the original BC Metal format available to the software BC transcoder.
+// nvn_fmt_to_mtl remains the canonical guest-format mapping; the no-BC path
+// substitutes its storage format later in nvn_mtl.m.
+int nvn_fmt_bc_mtl(uint32_t f, uint32_t *mtl) {
+    if (f < 0x41 || f > 0x50 || f >= sizeof T / sizeof *T || !T[f].kind) return 0;
+    if (mtl) *mtl = T[f].mtl;
+    return 1;
+}
