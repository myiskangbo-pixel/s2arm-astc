diff -ruN '--exclude=.git' s2arm-pristine/S2Arm-main/.github/workflows/bc-astc-port.yml s2arm-patch-base/S2Arm-main/.github/workflows/bc-astc-port.yml
--- s2arm-pristine/S2Arm-main/.github/workflows/bc-astc-port.yml	1970-01-01 00:00:00.000000000 +0000
+++ s2arm-patch-base/S2Arm-main/.github/workflows/bc-astc-port.yml	2026-11-23 10:37:15.862565334 +0000
@@ -0,0 +1,64 @@
+name: BC ASTC port validation
+
+on:
+  workflow_dispatch:
+  pull_request:
+    paths:
+      - 'graphics/nvn/**'
+      - '.github/workflows/bc-astc-port.yml'
+
+permissions:
+  contents: read
+
+concurrency:
+  group: bc-astc-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  portable-tests:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Build BC transcode and texture layout tests
+        run: make -C graphics/nvn/gfx/tex/tests t_bc_soft t_tex t_tex_layout
+      - name: Run BC transcode tests
+        run: ./graphics/nvn/gfx/tex/tests/t_bc_soft
+      - name: Run texture layout round-trip tests
+        run: ./graphics/nvn/gfx/tex/tests/t_tex
+      - name: Run texture shape tests
+        run: ./graphics/nvn/gfx/tex/tests/t_tex_layout
+      - name: AddressSanitizer and UndefinedBehaviorSanitizer
+        run: |
+          make -C graphics/nvn/gfx/tex/tests t_bc_soft \
+            CFLAGS='-O1 -g -Wall -Wextra -fsanitize=address,undefined -fno-omit-frame-pointer' \
+            -B
+          ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 \
+          UBSAN_OPTIONS=halt_on_error=1 \
+            ./graphics/nvn/gfx/tex/tests/t_bc_soft
+
+  ios-metal-build:
+    runs-on: macos-26
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Show Apple toolchain
+        run: |
+          xcodebuild -version
+          xcrun --sdk iphoneos --show-sdk-version
+          xcrun --find metal
+      - name: Run macOS texture tests
+        run: make -C graphics/nvn/gfx/tex/tests run
+      - name: Compile the iOS Metal/NVN backend
+        run: make -C graphics/nvn ios
+      - name: Upload iOS NVN static library
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: s2arm-nvn-ios-bc-astc
+          path: build/nvn/ios/libnvn.a
+          if-no-files-found: error
+          retention-days: 7
